<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.ophis.agent-usage-monitor</string>
	<key>ProgramArguments</key>
	<array>
		<string>@HOME@/Applications/AgentUsageMonitor.app/Contents/MacOS/AgentUsageMonitor</string>
	</array>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>@HOME@/Library/Logs/agent-usage-monitor.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/Library/Logs/agent-usage-monitor.log</string>
</dict>
</plist>
